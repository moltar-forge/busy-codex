{
  "name": "app.moltar.codex",
  "private": true,
  "version": "0.4.0",
  "description": "Remaining Codex usage over USB",
  "author": "Moltar Forge",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build": "busy-cli build",
    "app:install": "busy-cli app install",
    "app:uninstall": "busy-cli app uninstall",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop",
    "test": "node --test companion/usage.test.mjs test/*.test.mjs",
    "setup": "node scripts/setup.mjs install",
    "teardown": "node scripts/setup.mjs uninstall",
    "sync": "node companion/sync.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@busy-app/cli": "^0.6.0",
    "typescript": "~6.0.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.21.1"
  }
}
